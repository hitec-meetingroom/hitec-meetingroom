# 운영 모드: true=mock 데이터로 동작, false=실제 Graph API 호출
MOCK_MODE=true

# Microsoft Graph 인증 (MOCK_MODE=false 시 필수)
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# 회의실 정보
ROOM_EMAIL=room1@company.com
ROOM_DISPLAY_NAME=회의실 A

# 폴링 주기(초). 5분=300초 권장. 너무 짧으면 Graph throttling 위험.
POLL_INTERVAL_SEC=300

# 서버 바인딩
HOST=0.0.0.0
PORT=8000

# --- GitHub Actions (GitHub Pages용 status.json) ---
# 아래 값은 레포에 넣지 말고: Settings → Secrets and variables → Actions 에 등록
# TENANT_ID, CLIENT_ID, CLIENT_SECRET, ROOM_EMAIL, ROOM_DISPLAY_NAME
# 워크플로에서 MOCK_MODE=false 로 실행됨 (scripts/export_room_status.py)
